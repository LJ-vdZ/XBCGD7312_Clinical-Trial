# Unity YAML / text — keep mergeable, not LFS
* text=auto
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.compute text
*.json text
*.xml text
*.txt text
*.md text
*.meta text
*.prefab text
*.unity text
*.asset text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicMaterial text
*.physicsMaterial2D text
*.mask text
*.flare text
*.fontsettings text
*.guiskin text
*.inputactions text

