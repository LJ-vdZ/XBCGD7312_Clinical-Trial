  m_Script: {fileID: 11500000, guid: b585d5e4463127f438b6b2c620f02608, type: 3}
  m_Name: Tut_WelcomeManager
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptable
  dialogue:
  - type: 0
    dialogueText: Welcome to Clinical Trial!
  - type: 0
    dialogueText: "Here you will experience the challenges and pressures of running
      an understaffed and under-resourced clinic through various roles and how they
      impact each other. \nLets start off with the Manager!"
  - type: 0
    dialogueText: "The Manager can buy medicine when its running low or gets stolen.
      \nWalk up to the desk. Click \"E\" to interact with it and purchase some medicine
      for the clinic."
