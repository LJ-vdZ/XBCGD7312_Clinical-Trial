  m_Name: Tut_NurseWelcome
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptable
  dialogue:
  - type: 0
    dialogueText: The nurse helps assess patient state. Based on your assessment of
      the patient's state, you can label them critical or not critical. This labelling
      also helps the Manager decide who can be redirected to another hospital safely.
  - type: 0
    dialogueText: Click "E" to interact with a patient and assess their condition.
